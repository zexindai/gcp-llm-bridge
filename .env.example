# Copy to .env, chmod 600 .env, then fill keys locally. Never send keys in chat.
PORT=4000
# Publish on loopback first; use your host's LAN IP when clients need LAN access.
BIND_IP=127.0.0.1
BRIDGE_API_KEY=replace-me-with-an-independent-random-key
GOOGLE_API_KEY=replace-me-with-your-existing-google-key
# Required: replace YOUR_PROJECT_ID with your actual Google Cloud project ID.
UPSTREAM_URL=https://aiplatform.googleapis.com/v1/projects/YOUR_PROJECT_ID/locations/global/endpoints/openapi/chat/completions
# Models that passed the 2026-11-16 text probe with the current project/key; see doc/models.txt.
# Display list only; SSE, tools and long context have not been tested for every model.
AVAILABLE_MODELS=google/gemini-4-argon,google/gemini-4-hydrogen,google/gemini-4-carbon,google/gemini-3.8-flash,google/gemini-3.7-flash,google/gemini-3.6-flash,google/gemini-3.5-flash,google/gemini-3.5-flash-lite,google/gemini-3.1-pro-preview,google/gemini-3.1-pro-preview-customtools,google/gemini-3.1-flash-lite,google/gemini-3-flash-preview,google/gemini-2.5-flash,xai/grok-4.20-reasoning,xai/grok-4.20-non-reasoning,deepseek-ai/deepseek-v4.1-flash-maas,zai-org/glm-5.2-maas,openai/gpt-oss-120b-maas,google/gemma-4-26b-a4b-it-maas
CONNECT_TIMEOUT_MS=10000
IDLE_TIMEOUT_MS=600000
# Image used by the default compose.yaml; use a version tag to pin a release.
BRIDGE_IMAGE=ghcr.io/zexindai/gcp-llm-bridge:latest

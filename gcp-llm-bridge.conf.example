# Replace api.example.com, certificate paths and upstream IP before installing.
# 192.0.2.10 is a documentation-only IP; use the Bridge address reachable by Nginx.
# Clients supply BRIDGE_API_KEY through Authorization; do not hardcode keys here.
server {
    listen 80;
    listen [::]:80;
    server_name api.example.com;

    return 308 https://api.example.com$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name api.example.com;

    ssl_certificate /path/to/fullchain.pem;
    ssl_certificate_key /path/to/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 64m;

    location / {
        proxy_pass http://192.0.2.10:4000;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header Connection "";
        proxy_set_header Authorization $http_authorization;

        proxy_buffering off;
        proxy_request_buffering off;
        proxy_cache off;
        gzip off;

        proxy_connect_timeout 10s;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        send_timeout 600s;

        proxy_next_upstream off;
        proxy_intercept_errors off;
    }
}
